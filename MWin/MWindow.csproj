<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MashWin</RootNamespace>
    <AssemblyName>MWindow</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="MWindow/RoundButton.Content.cs"><DependentUpon>RoundButton.cs</DependentUpon></Compile>
    <Compile Update="MWindow.cs"><SubType>Form</SubType></Compile>
    <Compile Update="MWindow.Designer.cs"><DependentUpon>MWindow.cs</DependentUpon></Compile>
    <EmbeddedResource Update="MWindow.resx"><DependentUpon>MWindow.cs</DependentUpon></EmbeddedResource>
  </ItemGroup>
</Project>
